# Copy to .env (never commit .env). Anything starting EXPO_PUBLIC_ ends up inside the app and is public.
EXPO_PUBLIC_API_MODE=mock
EXPO_PUBLIC_API_URL=http://localhost:4000/v1
# Phase 2b: "payments" sends the payment calls to the sandbox server in server/ (server/README.md).
EXPO_PUBLIC_API_LIVE=
EXPO_PUBLIC_MOCK_LATENCY_MS=400
EXPO_PUBLIC_MOCK_FAIL_RATE=0
EXPO_PUBLIC_MOCK_FAST=0
EXPO_PUBLIC_SITE_URL=https://cravins.app
# Help page contact. Leave empty to hide the buttons.
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_SUPPORT_WHATSAPP=
# Roadmap previews with sample data (Stock, AI waiter, Marketing, Register). Set to true to show them.
PREVIEWS_ENABLED=false

# Server only (Phase 2b and later). Never put these in the app or in git.
# PAYSTACK_SECRET_KEY=sk_test_...
# DATABASE_URL=postgres://...
# OTP_PROVIDER_KEY=...
