# Copy to .env (never commit .env). Anything starting EXPO_PUBLIC_ ends up inside the app and is public.
EXPO_PUBLIC_API_MODE=mock
EXPO_PUBLIC_API_URL=http://localhost:4000/v1
# "mock" runs the in-app demo. "http" talks to the real server in server/ at EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_MOCK_LATENCY_MS=400
EXPO_PUBLIC_MOCK_FAIL_RATE=0
EXPO_PUBLIC_MOCK_FAST=0
EXPO_PUBLIC_SITE_URL=https://cravins.app
# Map tiles for the Business page. OpenStreetMap is fine for light use; pick a provider before a busy launch.
EXPO_PUBLIC_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Help page contact. Defaults: support@cravins.app and a DEMO WhatsApp number (233200000000).
# Set the real WhatsApp line here before launch.
EXPO_PUBLIC_SUPPORT_EMAIL=support@cravins.app
EXPO_PUBLIC_SUPPORT_WHATSAPP=233200000000
# Owner and staff sign-in for real-server builds (EXPO_PUBLIC_API_MODE=http). Clerk dashboard >
# API keys > Expo. The publishable key is safe in the app; the secret key goes on the server only.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Roadmap previews with sample data (Stock, AI waiter, Marketing, Register). Set to true to show them.
PREVIEWS_ENABLED=false

# Server only (Phase 2b and later). Never put these in the app or in git.
# PAYSTACK_SECRET_KEY=sk_test_...
# DATABASE_URL=postgres://...
# CLERK_SECRET_KEY=sk_test_...
