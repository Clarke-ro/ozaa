# Build-time flags for production exports (`npx expo export`). Not secrets, and not EXPO_PUBLIC_,
# so nothing here ends up inside the app.
# Tree shaking drops unused exports, e.g. the ~1,500 Lucide icons we never use.
# Both are "unstable" in Expo SDK 58: re-check after each SDK upgrade.
EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH=1
EXPO_UNSTABLE_TREE_SHAKING=1
