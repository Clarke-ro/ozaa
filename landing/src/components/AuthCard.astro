---
/**
 * Log in and Get started. The owner sign-in already exists in the Ozaa app (phone number and a
 * one-time code), so these pages hand over to it instead of being a second login form.
 */
import { authPages, routes } from "../content/page";
import Icon from "./Icon.astro";

interface Props {
  heading: string;
  lead: string;
  button: string;
  href: string;
  secondary?: { label: string; href: string };
  other: string;
  otherLink: string;
  otherHref: string;
}

const { heading, lead, button, href, secondary, other, otherLink, otherHref } = Astro.props;
---

<main class="auth" id="content">
  <a class="auth-logo" href={routes.home} aria-label="Ozaa home">
    <img src="/logo/ozaa-lockup.svg" alt="" width="451" height="140" />
  </a>
  <section class="auth-card" aria-labelledby="auth-title">
    <h1 id="auth-title">{heading}</h1>
    <p>{lead}</p>
    <a class="pill pill--orange pill--lg auth-main" href={href} data-astro-reload>{button}</a>
    {secondary ? <a class="pill pill--peach pill--lg auth-main" href={secondary.href} data-astro-reload>{secondary.label}</a> : null}
    <p class="auth-other">
      {other} <a href={otherHref}>{otherLink}</a>
    </p>
  </section>
  <a class="auth-back" href={routes.home}>
    <Icon name="back" size={18} />
    {authPages.back}
  </a>
</main>
