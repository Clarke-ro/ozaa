---
interface Props {
  id: string;
  heading: string;
}

const { id, heading } = Astro.props;
import { links } from "../content/links";
import { contact, contactLead } from "../content/page";
import { contactMode } from "../content/contact";

const mode = contactMode(contact);
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <div class="contact">
      <div class="contact-intro">
        <h2 id={`${id}-title`}>{heading}</h2>
        <p class="section-lead">{contactLead}</p>
        <div class="hero-actions">
          <a class="button button--light" href={links.app}>Open the Ozaa app</a>
          <a class="button button--outline-light" href={links.sample}>Try a sample table</a>
        </div>
      </div>

      <div class="contact-form">
        {
          mode === "ready" && contact.status === "ready" ? (
            <div class="channels">
              <a class="button" href={contact.whatsappHref}>
                WhatsApp
              </a>
              <a class="text-link" href={contact.phoneHref}>
                Phone
              </a>
              <a class="text-link" href={contact.emailHref}>
                Email
              </a>
            </div>
          ) : contact.status === "placeholder" ? (
            <>
              <p class="notice" id="contact-notice">
                {contact.notice}
              </p>
              <form
                id="contact-form"
                class="form"
                method="post"
                action="#contact"
                novalidate
                aria-describedby="contact-notice"
                data-missing-restaurant={contact.missingRestaurant}
                data-missing-name={contact.missingName}
                data-missing-reach={contact.missingReach}
              >
                <div class="form-row-2">
                  <label>
                    Restaurant
                    <input
                      name="restaurant"
                      type="text"
                      autocomplete="organization"
                      placeholder="Restaurant name…"
                      required
                    />
                  </label>
                  <label>
                    Your name
                    <input
                      name="name"
                      type="text"
                      autocomplete="name"
                      spellcheck="false"
                      placeholder="Your name…"
                      required
                    />
                  </label>
                </div>
                <fieldset class="reach" id="contact-reach">
                  <legend>How can we reply? Add at least one.</legend>
                  <div class="reach-fields">
                    <label>
                      Phone
                      <input
                        name="phone"
                        type="tel"
                        inputmode="tel"
                        autocomplete="tel"
                        spellcheck="false"
                        placeholder="Country code and number…"
                      />
                    </label>
                    <label>
                      Email
                      <input
                        name="email"
                        type="email"
                        inputmode="email"
                        autocomplete="email"
                        spellcheck="false"
                        placeholder="name@restaurant.com…"
                      />
                    </label>
                    <label>
                      WhatsApp
                      <input
                        name="whatsapp"
                        type="tel"
                        inputmode="tel"
                        autocomplete="tel"
                        spellcheck="false"
                        placeholder="Country code and number…"
                      />
                    </label>
                  </div>
                </fieldset>
                <label>
                  <span>Message <span class="optional">Optional.</span></span>
                  <textarea
                    name="message"
                    autocomplete="off"
                    placeholder="What do you want to know…"
                  />
                </label>
                <p class="error" id="contact-error" role="alert" hidden></p>
                <button class="button" type="submit">Send</button>
              </form>
              <p class="status" id="contact-status" role="status" tabindex="-1" hidden>
                {contact.held}
              </p>
            </>
          ) : (
            <p class="notice">
              Placeholder. Contact details are not on this page yet.
            </p>
          )
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { checkContactDraft, draftFromForm } from "../content/contact";

  const form = document.querySelector("#contact-form");
  const error = document.querySelector("#contact-error");
  const status = document.querySelector("#contact-status");
  if (
    form instanceof HTMLFormElement &&
    error instanceof HTMLElement &&
    status instanceof HTMLElement
  ) {
    const copy = {
      missingRestaurant: form.dataset.missingRestaurant ?? "",
      missingName: form.dataset.missingName ?? "",
      missingReach: form.dataset.missingReach ?? "",
    };
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      status.hidden = true;
      error.hidden = true;
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const result = checkContactDraft(draftFromForm(new FormData(form)), copy);
      if (!result.ok) {
        error.textContent = result.message;
        error.hidden = false;
        const field =
          result.field === "reach"
            ? form.querySelector<HTMLInputElement>('input[name="phone"]')
            : form.elements.namedItem(result.field);
        if (field instanceof HTMLElement) field.focus();
        return;
      }
      error.hidden = true;
      status.hidden = false;
      status.focus();
    });
  }
</script>
