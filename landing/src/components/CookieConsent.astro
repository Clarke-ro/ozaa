<div class="cookie-banner" id="cookie-banner" style="display: none;" role="region" aria-label="Cookie consent">
  <div class="wrap cookie-content">
    <div class="cookie-text">
      <strong>Privacy & Essential Cookies</strong>
      <span>
        Ozaa uses only essential cookies strictly necessary for table ordering sessions and Act 843 compliance. No cross-site advertising trackers are loaded.
      </span>
    </div>
    <div class="cookie-actions">
      <button type="button" class="button button--sm" id="cookie-accept-btn">
        Accept essential
      </button>
    </div>
  </div>
</div>

<script>
  function setupCookieConsent() {
    const banner = document.getElementById("cookie-banner");
    const acceptBtn = document.getElementById("cookie-accept-btn");
    if (!banner || !acceptBtn) return;

    if (!localStorage.getItem("ozaa_cookie_consent")) {
      banner.style.display = "block";
    }

    acceptBtn.addEventListener("click", () => {
      localStorage.setItem("ozaa_cookie_consent", "accepted");
      banner.style.display = "none";
    });
  }

  setupCookieConsent();
  document.addEventListener("astro:page-load", setupCookieConsent);
</script>
