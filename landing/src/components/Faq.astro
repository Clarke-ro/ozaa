---
import { faq } from "../content/page";
---

<section class="faq" id="faq" aria-labelledby="faq-title">
  <h2 id="faq-title" class="faq-title">{faq.heading}</h2>
  <div class="faq-list">
    {
      faq.items.map((item) => (
        <details class="faq-item">
          <summary>
            <span>{item.question}</span>
            <span class="faq-sign" aria-hidden="true" />
          </summary>
          <p>{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>
