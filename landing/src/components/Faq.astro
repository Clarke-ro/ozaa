---
/** A question-and-answer accordion. Used on Home, Pricing and Contact. */
interface Props {
  id: string;
  heading: string;
  items: readonly { question: string; answer: string }[];
  /** The section background: white on Home, warm grey on Pricing. */
  tone?: "white" | "warm";
}

const { id, heading, items, tone = "white" } = Astro.props;
---

<section class:list={["faq", `faq--${tone}`]} id={id} aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`} class="faq-title">{heading}</h2>
  <div class="faq-list">
    {
      items.map((item) => (
        <details class="faq-item">
          <summary>
            <span>{item.question}</span>
            <span class="faq-sign" aria-hidden="true" />
          </summary>
          <p>{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>
