---
import { screens, type ScreenName } from "../content/page";
import IPhone from "./IPhone.astro";

interface Props {
  title: string;
  body: string;
  screen: ScreenName;
}

const { title, body, screen } = Astro.props;
const shot = screens[screen];
---

<article class="feature">
  <div class="feature-copy">
    <h3>{title}</h3>
    <p>{body}</p>
  </div>
  <div class="feature-phone">
    <IPhone src={shot.src} alt={shot.alt} />
  </div>
</article>
