---
import { footer, routes } from "../content/page";
import SocialIcon from "./SocialIcon.astro";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-grid">
    <div class="footer-brand">
      <a href={routes.home} aria-label="Cravins home">
        <img src="/logo/cravins-lockup-light.svg" alt="" width="451" height="140" />
      </a>
      <p>{footer.tagline}</p>
      <div class="footer-social">
        <p>{footer.social}</p>
        <ul>
          {
            footer.socials.map((social) => (
              <li>
                <SocialIcon name={social.icon} title={social.name} url={social.url} />
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {
      footer.columns.map((column) => (
        <nav class="footer-column" aria-label={column.heading}>
          <h3>{column.heading}</h3>
          <ul>
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <div class="footer-column footer-column--cta">
      <h3>{footer.cta}</h3>
      <div class="footer-cta-buttons">
        <a class="pill pill--glass" href={routes.demo}>{footer.secondButton}</a>
        <a class="pill pill--orange" href={routes.start}>{footer.ctaButton}</a>
      </div>
      <p class="footer-cta-lead">{footer.lead}</p>
    </div>
  </div>

  <div class="footer-bottom">
    <p>© {year} Cravins. {footer.rights}</p>
    <nav aria-label={footer.legalHeading}>
      <ul class="footer-legal">
        {
          footer.legal.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
        <li>
          <button class="link-button" type="button" data-cookie-settings>
            {footer.cookieSettings}
          </button>
        </li>
      </ul>
    </nav>
  </div>
</footer>
