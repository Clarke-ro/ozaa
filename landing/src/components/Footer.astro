---
import { links } from "../content/links";
import { footer } from "../content/page";
import Icon from "./Icon.astro";

// Footer links name app pages as "app:<page>"; everything else is an anchor on this page.
const resolve = (href: string) =>
  href.startsWith("app:") ? links[href.slice(4) as keyof typeof links] : href;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-cta">
    <h2 class="reveal">{footer.cta}</h2>
    <a class="pill pill--white pill--lg" href={links.app}>{footer.ctaButton}</a>
  </div>

  <div class="footer-card">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="#top" aria-label="Ozaa, back to the top">
          <img src="/logo/ozaa-lockup.svg" alt="" width="451" height="140" />
        </a>
        <p>{footer.tagline}</p>
      </div>
      <div class="footer-columns">
        {
          footer.columns.map((column) => (
            <nav aria-label={column.heading}>
              <h3>{column.heading}</h3>
              <ul>
                {column.links.map((link) => (
                  <li>
                    <a href={resolve(link.href)}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-social">
        <p>{footer.social}</p>
        <ul>
          {
            footer.socials.map((social) => (
              <li>
                {social.url ? (
                  <a class="social" href={social.url} aria-label={social.name}>
                    <Icon name={social.icon} size={18} />
                  </a>
                ) : (
                  <span class="social" title={`${social.name} (coming soon)`}>
                    <Icon name={social.icon} size={18} label={`${social.name}, coming soon`} />
                  </span>
                )}
              </li>
            ))
          }
        </ul>
      </div>
      <ul class="footer-legal">
        {
          footer.legal.map((item) => (
            <li>{item.url ? <a href={item.url}>{item.label}</a> : <span>{item.label}</span>}</li>
          ))
        }
        <li>© {year} ozaa</li>
      </ul>
    </div>
  </div>
</footer>
