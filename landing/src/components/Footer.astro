---
import { footer, routes } from "../content/page";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-cta">
    <h2 class="reveal">{footer.cta}</h2>
    <a class="pill pill--white pill--lg" href={routes.start}>{footer.ctaButton}</a>
  </div>

  <div class="footer-card">
    <div class="footer-top">
      <div class="footer-brand">
        <a href={routes.home} aria-label="Ozaa home">
          <img src="/logo/ozaa-lockup.svg" alt="" width="451" height="140" />
        </a>
        <p>{footer.tagline}</p>
      </div>
      <div class="footer-columns">
        {
          footer.columns.map((column) => (
            <nav aria-label={column.heading}>
              <h3>{column.heading}</h3>
              <ul>
                {column.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-social">
        <p>{footer.social}</p>
        <ul>
          {
            footer.socials.map((social) => (
              <li>
                {social.url ? (
                  <a
                    class="social"
                    href={social.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${social.name} (opens in a new tab)`}
                  >
                    <Icon name={social.icon} size={18} />
                  </a>
                ) : (
                  <span class="social" title={`${social.name} (coming soon)`}>
                    <Icon name={social.icon} size={18} label={`${social.name}, coming soon`} />
                  </span>
                )}
              </li>
            ))
          }
        </ul>
      </div>
      <ul class="footer-legal">
        {footer.legal.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li>
          <button class="link-button" type="button" data-cookie-settings>
            {footer.cookieSettings}
          </button>
        </li>
        <li>© {year} ozaa</li>
      </ul>
    </div>
  </div>

  {/* The name, huge and faint, sunk into the footer's bottom edge. */}
  <p class="footer-watermark" aria-hidden="true">{footer.watermark}</p>
</footer>
