---
import { footer, sections } from "../content/page";
---

<footer class="footer">
  <div class="wrap">
    <div class="footer-bento">
      <div class="footer-brand">
        <a class="logo" href="#top" aria-label="Ozaa Home">
          <img src="/logo/ozaa-lockup.svg" alt="Ozaa" width="451" height="140" />
        </a>
        <p class="footer-tagline">{footer.line}</p>
        <div class="compliance-badge">
          <span class="compliance-dot"></span>
          <span>Data Protection Act 843 compliant · Paystack secured</span>
        </div>
      </div>

      <div class="footer-nav-columns">
        <div class="footer-col">
          <div class="footer-col-title">Product</div>
          <a href="#guests">Guest Features</a>
          <a href="#try-it">Interactive Preview</a>
          <a href="#how">How it Works</a>
          <a href="#why-ozaa">Why Ozaa</a>
          <a href="#pricing">Pricing Plans</a>
        </div>

        <div class="footer-col">
          <div class="footer-col-title">Owners & Staff</div>
          <a href="/owner/login" target="_blank" rel="noopener">Owner Sign In</a>
          <a href="#features">Table Management</a>
          <a href="#features">Digital Stamp Cards</a>
          <a href="#features">Reputation Shield</a>
          <a href="#questions">FAQ</a>
        </div>

        <div class="footer-col">
          <div class="footer-col-title">Legal & Contact</div>
          <a href="https://wa.me/233240000000" target="_blank" rel="noopener">WhatsApp Support</a>
          <a href="#contact">Restaurant Consultation</a>
          <a href="/privacy" style="pointer-events: none; opacity: 0.7;">Privacy Notice</a>
          <a href="/terms" style="pointer-events: none; opacity: 0.7;">Terms of Service</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom-bar">
      <p class="copyright">
        &copy; {new Date().getFullYear()} Ozaa. Built with craft for dining rooms everywhere.
      </p>
      <div class="footer-legal-note">
        Direct merchant payouts via Paystack split settlements.
      </div>
    </div>
  </div>
</footer>
