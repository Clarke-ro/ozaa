---
import { guestFeatures, guestLead } from "../content/page";
import FeatureCard from "./FeatureCard.astro";

interface Props {
  id: string;
  heading: string;
}

const { id, heading } = Astro.props;
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <header class="section-head section-head--center">
      <h2 id={`${id}-title`}>{heading}</h2>
      <p class="section-lead">{guestLead}</p>
    </header>
    <div class="feature-grid">
      {guestFeatures.map((feature) => <FeatureCard {...feature} />)}
    </div>
  </div>
</section>
