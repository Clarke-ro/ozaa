---
import { sections } from "../content/page";
---

<header class="header">
  <div class="wrap">
    <div class="bar">
      <a class="logo" href="#top">
        <img src="/logo/ozaa-lockup.svg" alt="Ozaa" width="451" height="140" />
      </a>
      <a class="button" href="#contact">
        Get Ozaa<span class="visually-hidden"> for your restaurant</span>
      </a>
    </div>
    <nav class="nav" aria-label="On this page">
      {
        sections.map((section) => (
          <a href={`#${section.id}`}>{section.nav}</a>
        ))
      }
    </nav>
  </div>
</header>
