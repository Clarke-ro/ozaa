---
import { links } from "../content/links";
import { headerNav, sections } from "../content/page";

const nav = sections.filter((section) => headerNav.includes(section.id));
---

<header class="header">
  <div class="wrap header-bar">
    <a class="logo" href="#top" aria-label="Ozaa, back to the top">
      <img src="/logo/ozaa-lockup.svg" alt="" width="451" height="140" />
    </a>
    <nav class="header-nav" aria-label="On this page">
      {nav.map((section) => <a href={`#${section.id}`}>{section.nav}</a>)}
    </nav>
    <a class="button button--sm" href={links.app}>
      Get Ozaa<span class="visually-hidden"> (opens the app)</span>
    </a>
  </div>
</header>
