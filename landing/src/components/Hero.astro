---
import { links } from "../content/links";
import { hero, screens } from "../content/page";
import IPhone from "./IPhone.astro";

const shot = screens[hero.screen];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-title">{hero.heading}</h1>
      <p class="hero-lead">{hero.lead}</p>
      <div class="hero-actions">
        <a class="button" href={links.app}>{hero.cta}</a>
        <a class="button button--ghost" href={links.sample}>{hero.secondary}</a>
      </div>
      <p class="fine">{hero.note}</p>
    </div>
    <div class="hero-phone">
      <IPhone src={shot.src} alt={shot.alt} priority />
    </div>
  </div>
</section>
