---
import { links } from "../content/links";
import { hero, screens } from "../content/page";
import IPhone from "./IPhone.astro";

const shot = screens[hero.screen];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero-inner">
    <div class="hero-text">
      <h1 id="hero-title">
        {hero.before}<span class="hero-highlight">{hero.highlight}</span>{hero.after}
      </h1>
      <p class="hero-lead">{hero.lead}</p>
      <div class="hero-buttons">
        <a class="pill pill--orange pill--lg" href={links.app}>{hero.primary}</a>
        <a class="pill pill--glass pill--lg" href="#how">{hero.secondary}</a>
      </div>
    </div>
    <div class="hero-phone">
      <IPhone src={shot.src} alt={shot.alt} priority />
    </div>
  </div>
</section>
