---
import { howLead, steps } from "../content/page";

interface Props {
  id: string;
  heading: string;
}

const { id, heading } = Astro.props;

// One simple line icon per step: a menu, a QR code, a phone with a tick.
const icons = [
  '<path d="M4 6h16M4 12h16M4 18h10"/>',
  '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><path d="M14 14h3v3M21 14v.01M14 21h7v-4"/>',
  '<rect x="6" y="2" width="12" height="20" rx="3"/><path d="m9.5 12 2 2 3.5-4"/>',
];
---

<section class="section section--soft" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <header class="section-head section-head--center">
      <h2 id={`${id}-title`}>{heading}</h2>
      <p class="section-lead">{howLead}</p>
    </header>
    <ol class="steps">
      {
        steps.map((step, index) => (
          <li class="step">
            <div class="step-top">
              <span class="step-number" aria-hidden="true">
                {index + 1}
              </span>
              <svg
                class="step-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={icons[index]}
              />
            </div>
            <h3>
              <span class="visually-hidden">Step {index + 1}: </span>
              {step.title}
            </h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
