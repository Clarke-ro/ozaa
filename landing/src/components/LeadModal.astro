---
---

<div class="lead-modal-backdrop" id="lead-modal" aria-hidden="true">
  <div class="lead-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="lead-modal-title">
    <div class="lead-modal-head">
      <div>
        <span class="bento-pill">Fast setup</span>
        <h2 id="lead-modal-title">Get Ozaa for your dining room</h2>
      </div>
      <button type="button" class="lead-modal-close" id="lead-modal-close" aria-label="Close modal">
        ✕
      </button>
    </div>

    <form class="lead-modal-form" id="lead-form">
      <div class="form-row">
        <label for="lead-restaurant">Restaurant or venue name *</label>
        <input
          type="text"
          id="lead-restaurant"
          name="restaurant"
          required
          placeholder="e.g. Buka Restaurant or Mama’s Kitchen"
        />
      </div>

      <div class="form-row">
        <label for="lead-name">Your name *</label>
        <input
          type="text"
          id="lead-name"
          name="name"
          required
          placeholder="e.g. Kwame Adom"
        />
      </div>

      <div class="form-row">
        <label for="lead-contact">Phone, WhatsApp or Email *</label>
        <input
          type="text"
          id="lead-contact"
          name="contact"
          required
          placeholder="024 123 4567 or owner@venue.com"
        />
      </div>

      <div class="form-row">
        <label for="lead-tables">Number of dining tables</label>
        <select id="lead-tables" name="tables">
          <option value="1-10">1 – 10 tables</option>
          <option value="11-25" selected>11 – 25 tables</option>
          <option value="26-50">26 – 50 tables</option>
          <option value="50+">50+ tables / Multi-location</option>
        </select>
      </div>

      <div class="form-submit-row">
        <button type="submit" class="button full-width" id="lead-submit-btn">
          Request free table setup
        </button>
      </div>

      <div class="lead-success-msg" id="lead-success" style="display: none;">
        ✓ Thank you! A hospitality specialist will reach out within 2 hours to help deploy your table codes.
      </div>

      <p class="form-footer-note">
        No payment details required. Protected by Data Protection Act 843.
      </p>
    </form>
  </div>
</div>

<script>
  function setupLeadModal() {
    const modal = document.getElementById("lead-modal");
    const closeBtn = document.getElementById("lead-modal-close");
    const form = document.getElementById("lead-form");
    const successMsg = document.getElementById("lead-success");
    const openBtns = document.querySelectorAll("[data-open-lead-modal]");

    if (!modal) return;

    const open = () => {
      modal.classList.add("lead-modal-backdrop--open");
      modal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      const firstInput = modal.querySelector<HTMLInputElement>("input");
      if (firstInput) firstInput.focus();
    };

    const close = () => {
      modal.classList.remove("lead-modal-backdrop--open");
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    };

    openBtns.forEach((btn) => btn.addEventListener("click", open));
    if (closeBtn) closeBtn.addEventListener("click", close);

    modal.addEventListener("click", (e) => {
      if (e.target === modal) close();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal.classList.contains("lead-modal-backdrop--open")) {
        close();
      }
    });

    if (form) {
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const submitBtn = document.getElementById("lead-submit-btn") as HTMLButtonElement | null;
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = "Sending request...";
        }

        setTimeout(() => {
          if (successMsg) successMsg.style.display = "block";
          if (submitBtn) submitBtn.style.display = "none";
          setTimeout(() => {
            close();
            form.reset();
            if (successMsg) successMsg.style.display = "none";
            if (submitBtn) {
              submitBtn.style.display = "block";
              submitBtn.disabled = false;
              submitBtn.textContent = "Request free table setup";
            }
          }, 3000);
        }, 600);
      });
    }
  }

  setupLeadModal();
  document.addEventListener("astro:page-load", setupLeadModal);
</script>
