---
import { nav, routes } from "../content/page";
import Icon from "./Icon.astro";

// Exact path match only: a blog post, Contact and the legal pages highlight nothing.
const here = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => href === here;
---

<header class="navbar-wrap">
  <nav class="navbar" aria-label="Main">
    <a class="navbar-logo" href={routes.home} aria-label="Cravins home">
      <img src="/logo/cravins-lockup-light.svg" alt="" width="588" height="140" />
    </a>
    <ul class="navbar-links">
      {
        nav.links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[{ active: isActive(link.href) }]}
              aria-current={isActive(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="navbar-actions">
      <a class="pill pill--glass" href={routes.login}>{nav.login}</a>
      <a class="pill pill--orange" href={routes.start}>{nav.start}</a>
    </div>
    <button
      class="navbar-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-open={nav.open}
      data-close={nav.close}
    >
      <span class="visually-hidden" data-toggle-label>{nav.open}</span>
      {/* The bars turn into a cross while the menu is open (CSS, from aria-expanded). */}
      <Icon name="menu" size={22} class="toggle-open" />
      <Icon name="close" size={22} class="toggle-close" />
    </button>
  </nav>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <button class="mobile-backdrop" type="button" tabindex="-1" aria-hidden="true" data-close></button>
    <div class="mobile-card" role="dialog" aria-modal="true" aria-label="Menu">
      {/* The visible close is the navbar's cross; this one is for keyboards and screen readers,
          which stay inside the card while it's open. It shows when it has focus. */}
      <button class="mobile-close visually-hidden" type="button" data-close>{nav.close}</button>
      <ul class="mobile-links">
        {
          nav.links.map((link, index) => (
            <li style={`--i: ${index}`}>
              <a
                href={link.href}
                data-close
                class:list={[{ active: isActive(link.href) }]}
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mobile-actions" style={`--i: ${nav.links.length}`}>
        <a class="pill pill--peach" href={routes.login} data-close>{nav.login}</a>
        <a class="pill pill--orange" href={routes.start} data-close>{nav.start}</a>
      </div>
    </div>
  </div>
</header>

<script>
  // The small-screen menu. It's set up again after each client-side page change, because the
  // navbar is part of the new page. Document-wide keys are bound once.
  type Menu = { open: () => void; close: (refocus?: boolean) => void; root: HTMLElement };
  let current: Menu | null = null;

  function setUp() {
    const toggle = document.querySelector<HTMLButtonElement>(".navbar-toggle");
    const root = document.querySelector<HTMLElement>("#mobile-menu");
    const label = toggle?.querySelector<HTMLElement>("[data-toggle-label]");
    if (!toggle || !root || !label) return;
    // Set up once per page: it runs both straight away and on Astro's page-load event.
    if (toggle.dataset.ready === "1") return;
    toggle.dataset.ready = "1";
    document.body.style.overflow = "";
    const focusables = () => [...root.querySelectorAll<HTMLElement>("a, button:not([tabindex='-1'])")];
    const open = () => {
      root.hidden = false;
      requestAnimationFrame(() => root.classList.add("is-open"));
      toggle.setAttribute("aria-expanded", "true");
      label.textContent = toggle.dataset.close ?? "";
      document.body.style.overflow = "hidden";
      focusables()[0]?.focus();
    };
    const close = (refocus = true) => {
      root.classList.remove("is-open");
      toggle.setAttribute("aria-expanded", "false");
      label.textContent = toggle.dataset.open ?? "";
      document.body.style.overflow = "";
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const hide = () => {
        if (!root.classList.contains("is-open")) root.hidden = true;
      };
      if (reduce) hide();
      else {
        root.addEventListener("transitionend", hide, { once: true });
        // Safari doesn't always send transitionend; hide it after the animation anyway.
        setTimeout(hide, 600);
      }
      if (refocus) toggle.focus();
    };
    toggle.addEventListener("click", () => (root.hidden ? open() : close()));
    // A link closes the menu (and the next page loads); the backdrop and × close it too.
    root.querySelectorAll<HTMLElement>("[data-close]").forEach((el) =>
      el.addEventListener("click", () => close(el.tagName !== "A")),
    );
    current = { open, close, root };
  }

  // Astro's page-load event sets it up after each page change; calling it now as well means the
  // menu works even if that event never fires on a phone's first load.
  document.addEventListener("astro:page-load", setUp);
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", setUp);
  else setUp();
  document.addEventListener("keydown", (event) => {
    if (!current || current.root.hidden) return;
    if (event.key === "Escape") current.close();
    if (event.key === "Tab") {
      const items = [...current.root.querySelectorAll<HTMLElement>("a, button:not([tabindex='-1'])")];
      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    }
  });
  // Older iPhones only have addListener on media queries; a missing addEventListener used to throw here.
  const wide = matchMedia("(min-width: 741px)");
  const onWide = (event: MediaQueryListEvent) => {
    if (event.matches && current && !current.root.hidden) current.close(false);
  };
  if (wide.addEventListener) wide.addEventListener("change", onWide);
  else wide.addListener(onWide);
</script>
