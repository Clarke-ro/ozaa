---
import { later, laterIntro, ownerLead, ownerNow } from "../content/page";
import FeatureCard from "./FeatureCard.astro";

interface Props {
  id: string;
  heading: string;
}

const { id, heading } = Astro.props;
---

<section class="section section--soft" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <header class="section-head section-head--center">
      <h2 id={`${id}-title`}>{heading}</h2>
      <p class="section-lead">{ownerLead}</p>
    </header>
    <div class="feature-grid">
      {ownerNow.map((item) => <FeatureCard {...item} />)}
    </div>

    <div class="later">
      <div class="later-head">
        <h3>Coming later</h3>
        <p>{laterIntro}</p>
      </div>
      <ul class="later-list">
        {
          later.map((item) => (
            <li>
              <h4>{item.title}</h4>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
