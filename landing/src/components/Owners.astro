---
interface Props {
  id: string;
  heading: string;
}

const { id, heading } = Astro.props;
import {
  later,
  laterIntro,
  ownerIntro,
  ownerNow,
  screenSize,
  screens,
} from "../content/page";
import IPhoneMockup from "./IPhoneMockup.astro";
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <div class="section-head">
      <span class="section-tag">Owner console</span>
      <h2 id={`${id}-title`}>{heading}</h2>
      <p class="section-sub">{ownerIntro}</p>
    </div>

    <div class="bento-grid bento-grid--owners">
      {
        ownerNow.map((item, idx) => {
          const shot = screens[item.screen];
          return (
            <article
              class={`bento-card bento-card--owner ${
                idx === 0 ? "bento-card--tone-tint" : "bento-card--tone-default"
              }`}
            >
              <div class="bento-copy">
                <span class="bento-pill">Ready now</span>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
              <div class="bento-mockup">
                <IPhoneMockup
                  src={shot.src}
                  alt={shot.alt}
                  width={screenSize.width}
                  height={screenSize.height}
                  size="bento"
                />
              </div>
            </article>
          );
        })
      }
    </div>

    <div class="owner-roadmap">
      <div class="roadmap-head">
        <div>
          <span class="section-tag">Roadmap</span>
          <h3>Later</h3>
        </div>
        <p>{laterIntro}</p>
      </div>
      <div class="bento-grid bento-grid--later">
        {
          later.map((item, index) => (
            <article class="bento-card bento-card--later">
              <div class="later-top">
                <span class="icon-badge" aria-hidden="true">0{index + 1}</span>
                <span class="bento-pill bento-pill--muted">Planned</span>
              </div>
              <h4>{item.title}</h4>
              <p>{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
