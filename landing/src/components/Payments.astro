---
interface Props {
  id: string;
  heading: string;
}

const { id, heading } = Astro.props;
import { payments } from "../content/page";
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <h2 id={`${id}-title`}>{heading}</h2>
    <p>{payments.lead}</p>
    <div class="methods">
      {
        payments.methods.map((method) => (
          <article>
            <h3>{method.title}</h3>
            <p>{method.body}</p>
          </article>
        ))
      }
    </div>
    <p class="close">{payments.close}</p>
  </div>
</section>
