---
import { payments, screens } from "../content/page";
import IPhone from "./IPhone.astro";

interface Props {
  id: string;
  heading: string;
}

const { id, heading } = Astro.props;
const shot = screens[payments.screen];

// A card, a phone wallet and a bank, one simple line icon each.
const icons = [
  '<rect x="2" y="5" width="20" height="14" rx="2.5"/><path d="M2 10h20M6 15h4"/>',
  '<rect x="6" y="2" width="12" height="20" rx="3"/><path d="M11 18h2"/>',
  '<path d="M3 10 12 4l9 6M5 10v8M9.5 10v8M14.5 10v8M19 10v8M3 20h18"/>',
];
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap pay-grid">
    <div class="pay-copy">
      <h2 id={`${id}-title`}>{heading}</h2>
      <p class="section-lead">{payments.lead}</p>
      <ul class="methods">
        {
          payments.methods.map((method, index) => (
            <li>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={icons[index]}
              />
              <div>
                <h3>{method.title}</h3>
                <p>{method.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <div class="direct">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
          <path d="m9 12 2 2 4-4" />
        </svg>
        <div>
          <h3>{payments.direct.title}</h3>
          <p>{payments.direct.body}</p>
        </div>
      </div>
    </div>
    <div class="pay-phone">
      <IPhone src={shot.src} alt={shot.alt} />
    </div>
  </div>
</section>
