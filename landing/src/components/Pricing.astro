---
interface Props {
  id: string;
  heading: string;
}

const { id, heading } = Astro.props;
import { pricing } from "../content/page";

const tiers = [
  {
    name: "Starter",
    badge: "Cafés & Pop-ups",
    priceMonthly: "Free",
    priceAnnual: "Free",
    period: "forever",
    desc: "Essential digital dining for single-location cafés and casual eateries.",
    features: [
      "Up to 15 tables with QR codes",
      "Interactive mobile menu with search",
      "One-tap guest Wi-Fi connect",
      "Waiter call service queue",
      "Standard email support",
    ],
    cta: "Start free",
    popular: false,
  },
  {
    name: "Professional",
    badge: "Full-Service Restaurants",
    priceMonthly: "Standard",
    priceAnnual: "Standard",
    period: "per venue / month",
    desc: "Complete guest experience with split payments, loyalty and reputation tools.",
    features: [
      "Unlimited dining tables and rooms",
      "Paystack split payments (MoMo & card)",
      "Digital loyalty stamp cards & wallet passes",
      "Private feedback inbox with sentiment gating",
      "Table card printable PDF generator",
      "Priority WhatsApp hospitality support",
    ],
    cta: "Request restaurant demo",
    popular: true,
  },
  {
    name: "Multi-Venue",
    badge: "Restaurant Groups & Chains",
    priceMonthly: "Custom",
    priceAnnual: "Custom",
    period: "enterprise",
    desc: "Centralized control across multiple branches with role-based permissions.",
    features: [
      "Multi-location switcher in one dashboard",
      "Dedicated handheld scanner device pairing",
      "Staff role access (Manager, Waiter, Kitchen)",
      "Custom brand typography & styling presets",
      "Consolidated multi-branch analytics",
      "Dedicated account manager",
    ],
    cta: "Contact enterprise team",
    popular: false,
  },
] as const;
---

<section class="section section--pricing" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <div class="section-head text-center">
      <span class="section-tag">Predictable pricing</span>
      <h2 id={`${id}-title`}>{heading}</h2>
      <p class="section-sub">
        Simple, honest plans designed to scale with your dining room without surprise fees.
      </p>

      <!-- Monthly / Annual Toggle -->
      <div class="pricing-toggle-wrap">
        <span class="pricing-toggle-label pricing-toggle-label--active" id="label-monthly">Monthly</span>
        <button
          type="button"
          class="pricing-toggle-btn"
          id="pricing-toggle"
          role="switch"
          aria-checked="false"
          aria-label="Toggle annual billing for discount"
        >
          <span class="pricing-toggle-thumb"></span>
        </button>
        <span class="pricing-toggle-label" id="label-annual">
          Annual <span class="discount-pill">Save 20%</span>
        </span>
      </div>
    </div>

    <!-- Tiers Grid -->
    <div class="pricing-grid">
      {
        tiers.map((tier) => (
          <article class={`pricing-card bento-card ${tier.popular ? "pricing-card--popular" : ""}`}>
            {tier.popular ? (
              <div class="popular-ribbon">Most Popular</div>
            ) : null}

            <div class="pricing-card-head">
              <span class="bento-pill">{tier.badge}</span>
              <h3 class="tier-title">{tier.name}</h3>
              <p class="tier-desc">{tier.desc}</p>
            </div>

            <div class="pricing-price-box">
              <span class="tier-price" data-monthly={tier.priceMonthly} data-annual={tier.priceAnnual}>
                {tier.priceMonthly}
              </span>
              <span class="tier-period">{tier.period}</span>
            </div>

            <ul class="tier-features" aria-label={`${tier.name} plan features`}>
              {tier.features.map((feat) => (
                <li>
                  <span class="feature-check" aria-hidden="true">✓</span>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>

            <div class="tier-action">
              <button
                type="button"
                class={`button ${tier.popular ? "" : "button--secondary"} full-width`}
                data-open-lead-modal
              >
                {tier.cta}
              </button>
            </div>
          </article>
        ))
      }
    </div>

    {
      pricing.status === "placeholder" ? (
        <div class="bento-card bento-card--slot slot pricing-placeholder-box">
          <div class="slot-head">
            <span class="bento-pill">Status · Placeholder</span>
          </div>
          <p class="placeholder-copy">{pricing.body}</p>
        </div>
      ) : null
    }
  </div>
</section>

<script>
  function setupPricingToggle() {
    const toggle = document.getElementById("pricing-toggle");
    const labelMonthly = document.getElementById("label-monthly");
    const labelAnnual = document.getElementById("label-annual");
    if (!toggle) return;

    let isAnnual = false;
    toggle.addEventListener("click", () => {
      isAnnual = !isAnnual;
      toggle.setAttribute("aria-checked", String(isAnnual));
      toggle.classList.toggle("pricing-toggle-btn--active", isAnnual);

      if (labelMonthly && labelAnnual) {
        labelMonthly.classList.toggle("pricing-toggle-label--active", !isAnnual);
        labelAnnual.classList.toggle("pricing-toggle-label--active", isAnnual);
      }
    });
  }

  setupPricingToggle();
  document.addEventListener("astro:page-load", setupPricingToggle);
</script>
