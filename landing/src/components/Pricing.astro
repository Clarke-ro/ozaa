---
import { pricing } from "../content/page";

interface Props {
  id: string;
  heading: string;
}

const { id, heading } = Astro.props;
---

<section class="section section--tight" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap narrow">
    {
      pricing.status === "placeholder" ? (
        <div class="pricing-note">
          <h2 id={`${id}-title`}>{heading}</h2>
          <p>{pricing.body}</p>
        </div>
      ) : (
        <>
          <header class="section-head section-head--center">
            <h2 id={`${id}-title`}>{heading}</h2>
          </header>
          <div class="plans">
            {pricing.plans.map((plan) => (
              <article class="plan">
                <h3>{plan.name}</h3>
                <p class="price">{plan.price}</p>
                <p>{plan.detail}</p>
              </article>
            ))}
          </div>
        </>
      )
    }
  </div>
</section>
