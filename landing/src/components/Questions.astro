---
interface Props {
  id: string;
  heading: string;
}

const { id, heading } = Astro.props;
import { questions } from "../content/page";
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <h2 id={`${id}-title`}>{heading}</h2>
    <div class="faq">
      {
        questions.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
