---
import { questions } from "../content/page";

interface Props {
  id: string;
  heading: string;
}

const { id, heading } = Astro.props;
---

<section class="section section--soft" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap narrow">
    <header class="section-head section-head--center">
      <h2 id={`${id}-title`}>{heading}</h2>
    </header>
    <div class="faq">
      {
        questions.map((item) => (
          <details class="faq-item">
            <summary>
              <span>{item.question}</span>
              <svg
                class="faq-chevron"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
