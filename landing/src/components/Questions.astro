---
interface Props {
  id: string;
  heading: string;
}

const { id, heading } = Astro.props;
import { questions } from "../content/page";
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <div class="section-head">
      <span class="section-tag">FAQ</span>
      <h2 id={`${id}-title`}>{heading}</h2>
    </div>
    <div class="faq-bento">
      {
        questions.map((item) => (
          <details class="bento-card bento-card--faq">
            <summary>
              <span>{item.question}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
