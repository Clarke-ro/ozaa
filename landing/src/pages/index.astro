---
import Faq from "../components/Faq.astro";
import Features from "../components/Features.astro";
import FloatingCta from "../components/FloatingCta.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Navbar from "../components/Navbar.astro";
import Statement from "../components/Statement.astro";
import WhoFor from "../components/WhoFor.astro";
import WhyOzaa from "../components/WhyOzaa.astro";
import Base from "../layouts/Base.astro";
---

<Base>
  <Navbar />
  <main id="content">
    <Hero />
    <Statement />
    <Features />
    <HowItWorks />
    <WhoFor />
    <WhyOzaa />
    <Faq />
  </main>
  <Footer />
  <FloatingCta />
</Base>

<script>
  // Cards and headings fade up as they scroll into view. Without JavaScript, or with
  // Reduce Motion on, everything simply shows (see .reveal in global.css).
  const items = document.querySelectorAll<HTMLElement>(".reveal");
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
    document.documentElement.classList.add("can-reveal");
    const seen = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-visible");
          seen.unobserve(entry.target);
        }
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
    );
    items.forEach((item) => seen.observe(item));
  }
</script>
