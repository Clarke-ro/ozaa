---
import AlternatingFeatures from "../components/AlternatingFeatures.astro";
import Contact from "../components/Contact.astro";
import CookieConsent from "../components/CookieConsent.astro";
import CtaBand from "../components/CtaBand.astro";
import DemoBullets from "../components/DemoBullets.astro";
import Footer from "../components/Footer.astro";
import Guests from "../components/Guests.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import How from "../components/How.astro";
import LeadModal from "../components/LeadModal.astro";
import Owners from "../components/Owners.astro";
import PainPoints from "../components/PainPoints.astro";
import Payments from "../components/Payments.astro";
import Pricing from "../components/Pricing.astro";
import Questions from "../components/Questions.astro";
import ReplacesStrip from "../components/ReplacesStrip.astro";
import TryPreview from "../components/TryPreview.astro";
import { sections, type SectionId } from "../content/page";
import Base from "../layouts/Base.astro";

const views = {
  how: How,
  guests: Guests,
  owners: Owners,
  pay: Payments,
  pricing: Pricing,
  questions: Questions,
  contact: Contact,
} satisfies Record<SectionId, typeof How>;
---

<Base>
  <Header />
  <main id="content">
    <Hero />
    <DemoBullets />
    <TryPreview />
    <ReplacesStrip />
    <PainPoints />
    <AlternatingFeatures />
    {
      sections.map((section) => {
        const View = views[section.id];
        if (!View) return null;
        return <View id={section.id} heading={section.heading} />;
      })
    }
    <CtaBand />
  </main>
  <Footer />
  <LeadModal />
  <CookieConsent />
</Base>
