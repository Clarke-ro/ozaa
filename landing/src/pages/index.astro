---
import Faq from "../components/Faq.astro";
import Features from "../components/Features.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Statement from "../components/Statement.astro";
import WhoFor from "../components/WhoFor.astro";
import WhyCravins from "../components/WhyCravins.astro";
import { faq, hero, screens } from "../content/page";
import Site from "../layouts/Site.astro";
---

<Site preload={screens[hero.screen].src}>
  <Hero />
  <Statement />
  <Features />
  <HowItWorks />
  <WhoFor />
  <WhyCravins />
  <Faq id="faq" heading={faq.heading} items={faq.items} />
</Site>
