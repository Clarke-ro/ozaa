  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "gen:api": "openapi-typescript api/openapi.yaml -o src/lib/api/schema.ts",
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "copy:fixtures": "node scripts/copy-fixtures.mjs",
    "gen:media": "node scripts/gen-media.mjs",
    "check:fixtures": "node api/fixtures/check-fixtures.mjs",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "e2e": "expo export -p web && playwright test",
    "prepare": "husky"
  },
  "private": true,
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
