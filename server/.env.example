# Copy to server/.env (git ignores it) and fill in. Never commit the real file.

# Payments use each venue's own Paystack keys (owner app > Settings > Integrations), sealed with
# ENCRYPTION_KEY. Make it once with: openssl rand -hex 32. Changing it means venues reconnect.
ENCRYPTION_KEY=

# Signs guest tokens. Any long random string (openssl rand -hex 32).
GUEST_TOKEN_SECRET=

# Optional, for testing only: with SEED_SAMPLES=true, `npm run db:seed` adds the sample venues and
# connects them to this Paystack TEST account (Paystack dashboard > Settings > API Keys & Webhooks).
# Live keys (sk_live_, pk_live_) are refused.
SEED_SAMPLES=true
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Postgres connection string. For Supabase: the Connect button > "Session pooler". Not the direct
# db.<project>.supabase.co address: that one is IPv6 only, and Heroku can't reach IPv6.
# It holds your database password.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

PORT=4000

# Where Paystack sends a card payer back: {SITE_URL}/{venueSlug}/pay
SITE_URL=http://localhost:8081

# Browser addresses allowed to call this server, comma separated.
ALLOWED_ORIGINS=http://localhost:8081

# Photo uploads (Supabase Storage, bucket "media"). The URL is public; the secret key is in the
# Supabase dashboard > Project Settings > API Keys > Secret keys. Never put it in the app.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=
