# Copy to server/.env (git ignores it) and fill in. Never commit the real file.

# Your Paystack TEST secret key: Paystack dashboard > Settings > API Keys & Webhooks.
# The server refuses to start with a live key (sk_live_).
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

PORT=4000

# Where Paystack sends a card payer back: {SITE_URL}/{venueSlug}/pay
SITE_URL=http://localhost:8081

# Browser addresses allowed to call this server, comma separated.
ALLOWED_ORIGINS=http://localhost:8081
