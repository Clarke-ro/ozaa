# Copy to .env (never commit .env). Anything starting EXPO_PUBLIC_ ends up inside the app and is PUBLIC.
EXPO_PUBLIC_API_MODE=mock            # mock | http
EXPO_PUBLIC_API_URL=http://localhost:4000/v1
EXPO_PUBLIC_API_LIVE=                # Phase 2b only, e.g. "payments": these features use the server, the rest stay mocked
EXPO_PUBLIC_MOCK_LATENCY_MS=400
EXPO_PUBLIC_MOCK_FAIL_RATE=0         # 0..1, random network failures to test error states
EXPO_PUBLIC_MOCK_FAST=0              # 1 = order and payment timers 10x faster for demos

# ---- server/.env only (Phase 2b and later). NEVER put these in the app or in git. ----
# PAYSTACK_SECRET_KEY=sk_test_...
# DATABASE_URL=postgres://...
# OTP_PROVIDER_KEY=...
